{
  "version": 1,
  "author": "Camila Gois",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": 20,
      "left": 300,
      "attrs": {
        "temperature": "28",
        "humidity": "65"
      }
    }
  ],
  "connections": [
    ["dht:VCC", "esp:5V", "red", ["v0"]],
    ["dht:GND", "esp:GND.1", "black", ["v0"]],
    ["dht:SDA", "esp:4", "green", ["v0"]],
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  }
}